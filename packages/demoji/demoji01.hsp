//#include "hsp3dish.as"
#include "hgimg4.as"

#module
#defcfunc _fromcode int code, local _buf
    sdim _buf, 64
    if code < 0x80 {
        poke _buf, 0, code
        return _buf
    }
    if code < 0x0800 { // 11bit
        poke _buf, 0, 0xc0 | ((code >> 6) & 0x1f)
        poke _buf, 1, 0x80 | (code & 0x3f)
        return _buf
    }
    if code < 0x10000 { // 16bit
        poke _buf, 0, 0xe0 | ((code >> 12) & 0x0f)
        poke _buf, 1, 0x80 | ((code >> 6) & 0x3f)
        poke _buf, 2, 0x80 | (code & 0x3f)
        return _buf
    }
    // 21bit
    poke _buf, 0, 0xf0 | ((code >> 18) & 0x07)
    poke _buf, 1, 0x80 | ((code >> 12) & 0x3f)
    poke _buf, 2, 0x80 | ((code >> 6) & 0x3f)
    poke _buf, 3, 0x80 | (code & 0x3f)
    return _buf

#global


	font "Noto Sans JP", 20
*main
    getreq fps, SYSREQ_FPS // HGIMG4 のみ
    getreq timer, SYSREQ_TIMER

    redraw 0
    color 0xaa, 0xaa, 0xaa
    boxf

    pos 8, 8

	s = _fromcode(0x2600)
	//mes s

	s = "あるぇ?"
	//mes s

    s = ""
    code = 0x1f400

    color 255,255,255
    repeat 16
        s = ""
        repeat 16
            s += _fromcode(code)
            code += 1
        loop
        mes s
        
        //color 0, 0xaa, 0
    loop

    s = "もしかして💖途中無くなるのはNGでは???"
    color 0, 0xaa, 0
    mes s

    mes strf("%d [fps], %d", fps, timer)

    redraw 1
    await 1000/60
    goto *main

