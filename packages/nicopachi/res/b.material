
material mtl00000 {
  u_worldViewProjectionMatrix = WORLD_VIEW_PROJECTION_MATRIX
  u_matrixPalette = MATRIX_PALETTE

  u_ambientColor = 0.1, 0.1, 0.1
  u_cameraPosition = CAMERA_WORLD_POSITION
  u_diffuseColor = 0.764, 0.050, 0.137, 1.0
  u_inverseTransposeWorldViewMatrix = INVERSE_TRANSPOSE_WORLD_VIEW_MATRIX
  u_specularExponent = 20

  renderState {
    cullFace = false
    depthTest = true
  }
  technique {
    pass {
      defines = SPECULAR;DIRECTIONAL_LIGHT_COUNT 1;SKINNING;SKINNING_JOINT_COUNT 2
      vertexShader = res/shaders/a_colored.vert
      fragmentShader = res/shaders/a_colored.frag
    }
  }
}


